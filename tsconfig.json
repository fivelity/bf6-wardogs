{
  "compilerOptions": {
    "declaration": true,
    "outDir": "build",
    "rootDir": "src",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "ES2015",
    "module": "ES2015",
    "lib": ["ES2015"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "types": ["bf6-portal-mod-types"]
  },
  "include": ["src", "mock-server.ts"]
}
