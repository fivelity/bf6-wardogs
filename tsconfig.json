{
  "compilerOptions": {
    "declaration": true,
    "outDir": "build",
    "rootDir": "src",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "ES2015",
    "module": "ES2015",
    "lib": ["ES2015"],
    "skipLibCheck": true,
    "types": ["ts-bf6-portal/global"]
  },
  "include": ["src"]
}
