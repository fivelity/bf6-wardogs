{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2017", "DOM"],

    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    "strict": true,
    "skipLibCheck": true,

    "declaration": true,
    "rootDir": "src",
    "outDir": "build",

    "noEmit": true,
    "types": ["bf6-portal-mod-types"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
