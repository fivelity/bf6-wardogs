{
  "compilerOptions": {
    "declaration": true,
    "outDir": "build",
    "rootDir": "src",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "ES2015",
    "module": "ES2015",
    "lib": ["ES2017"],
    "skipLibCheck": true,
    "types": ["bf6-portal-mod-types"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/mock-server.ts"]
}
